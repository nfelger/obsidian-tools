{
  "name": "bullet-flow",
  "version": "0.16.2",
  "description": "BuJo-inspired workflow: extract logs and migrate tasks from daily notes",
  "main": "main.js",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks",
    "pretest": "node -e \"require('fs').existsSync('node_modules/.bin/vitest') || require('child_process').execSync('npm install', {stdio: 'inherit'})\"",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "oxlint src tests scripts",
    "lint:guided": "node lint-guided.mjs",
    "lint:fix": "oxlint --fix src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:crap": "vitest run --coverage --coverage.provider=istanbul --coverage.reporter=json --coverage.reportsDirectory=coverage-istanbul --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:ui": "vitest --ui",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bullet-journal",
    "bujo",
    "task-management"
  ],
  "author": "nfelger",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/types": "^9.30.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "moment": "^2.30.1",
    "obsidian": "1.11.4",
    "obsidian-daily-notes-interface": "^0.9.5",
    "oxlint": "^1.77.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "wdio-obsidian-service": "^3.0.2"
  }
}
